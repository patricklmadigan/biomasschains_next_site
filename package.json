    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "autoprefixer": "10.4.19",
    "esbuild": "0.28.2",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.38",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.7",
    "wrangler": "4.149.0"
  }
